{
  "name": "@pinery/adapter",
  "version": "0.1.0",
  "description": "Pinery adapter: Feishu/Lark long-connection gateway, session routing, cards, storage, and the pinery CLI",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pinery": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./investigation": {
      "types": "./dist/investigation.d.ts",
      "default": "./dist/investigation.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    },
    "./document-actions": {
      "types": "./dist/document-actions.d.ts",
      "default": "./dist/document-actions.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./sqlite-driver": {
      "types": "./dist/sqlite-driver.d.ts",
      "default": "./dist/sqlite-driver.js"
    },
    "./lark/cards": {
      "types": "./dist/lark/cards.d.ts",
      "default": "./dist/lark/cards.js"
    },
    "./lark/events": {
      "types": "./dist/lark/events.d.ts",
      "default": "./dist/lark/events.js"
    },
    "./lark/messenger": {
      "types": "./dist/lark/messenger.d.ts",
      "default": "./dist/lark/messenger.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@pinery/core": "workspace:*",
    "@pinery/lark-fetch": "workspace:*",
    "@pinery/runner-pi": "workspace:*",
    "@pinery/skills": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  }
}
